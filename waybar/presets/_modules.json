{
  "custom/launcher": {
    "format": "",
    "tooltip-format": "Applications\nLeft: launcher · Right: terminal",
    "on-click": "hyprlauncher",
    "on-click-right": "kitty"
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三",
      "4": "四",
      "5": "五",
      "6": "六",
      "7": "七",
      "8": "八",
      "9": "九",
      "10": "十",
      "default": "◉"
    },
    "persistent-workspaces": {
      "*": 6
    },
    "all-outputs": true,
    "move-to-monitor": true,
    "disable-scroll": true,
    "sort-by": "number",
    "on-click": "activate",
    "on-click-right": "close",
    "tooltip": false
  },
  "custom/hyprsunset": {
    "format": "󰌵",
    "tooltip-format": "Hyprsunset Dimmer\nLeft: open sliders · Scroll: quick adjust",
    "on-click": "python3 $HOME/.config/waybar/scripts/hyprsunset-slider.py",
    "on-scroll-up": "hyprctl hyprsunset gamma +5",
    "on-scroll-down": "hyprctl hyprsunset gamma -5"
  },
  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Power menu\nAsks for confirmation first",
    "on-click": "$HOME/.config/waybar/scripts/power-menu"
  },
  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 900,
    "exec": "$HOME/.config/waybar/wttrbar --nerd --location Salatiga",
    "return-type": "json"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": "󰁳"
    }
  },
  "backlight": {
    "format": "{icon}",
    "tooltip": true,
    "tooltip-format": "Brightness: {percent}%",
    "format-alt": "{percent}%",
    "format-alt-click": "click-right",
    "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-down": "brightnessctl s 5%-",
    "on-scroll-up": "brightnessctl s +5%"
  },
  "pulseaudio": {
    "format": "{icon}",
    "tooltip-format": "Volume: {volume}%\nLeft: mixer · Right: mute",
    "on-click": "sh -c 'command -v pavucontrol >/dev/null && pavucontrol || kitty -e alsamixer'",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "network": {
    "format": "{icon} {essid}",
    "format-wifi": "{icon} {essid}",
    "format-ethernet": "󰈀 wired",
    "format-disconnected": "󰤮 offline",
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "tooltip-format-ethernet": "Ethernet\n⇣ {bandwidthDownBytes}  ⇡ {bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 5,
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}\n{num_connections} connected",
    "on-click": "blueman-manager"
  },
  "battery": {
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": " plugged",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "tooltip-format-discharging": "{power:>1.0f}W ↓ · {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W ↑ · {capacity}%",
    "interval": 5,
    "states": {
      "warning": 20,
      "critical": 10
    }
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "tooltip-format-activated": "Stay awake: ON",
    "tooltip-format-deactivated": "Stay awake: OFF",
    "format-icons": {
      "activated": "󱎴",
      "deactivated": "󰷛"
    }
  },
  "tray": {
    "icon-size": 14,
    "spacing": 3
  },
  "custom/control": {
    "format": "󰒓",
    "tooltip-format": "Desktop controls\nLeft: menu · Scroll: theme",
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/control-menu.xml",
    "menu-actions": {
      "control_center": "$HOME/.config/hypr/scripts/hypr-control-center --tab theme",
      "theme_next": "$HOME/.config/hypr/scripts/theme-switch next",
      "wallpaper_random": "$HOME/.config/hypr/scripts/wallpaper-set --random",
      "wallpaper_picker": "$HOME/.config/hypr/scripts/hypr-control-center --tab wallpaper",
      "waybar_picker": "$HOME/.config/hypr/scripts/hypr-control-center --tab bar",
      "waybar_restart": "$HOME/.config/waybar/scripts/restart-waybar",
      "notifications": "dunstctl set-paused toggle",
      "updates": "$HOME/.config/waybar/scripts/open-updates",
      "screenshot": "sh -c 'grim -g \"$(slurp -d)\" - | wl-copy'",
      "pick_color": "hyprpicker -a",
      "lock": "sh -c 'pidof hyprlock || hyprlock'",
      "power": "$HOME/.config/waybar/scripts/power-menu"
    },
    "on-click-right": "$HOME/.config/hypr/scripts/hypr-control-center --tab theme",
    "on-scroll-up": "$HOME/.config/hypr/scripts/theme-switch next",
    "on-scroll-down": "$HOME/.config/hypr/scripts/theme-switch prev"
  },
  "custom/resources": {
    "exec": "$HOME/.config/waybar/scripts/resources",
    "interval": 2,
    "return-type": "json",
    "format": "󰍛 {}",
    "on-click": "kitty -e btop"
  },
  "custom/cava": {
    "exec": "$HOME/.config/waybar/scripts/cava-waybar",
    "return-type": "json",
    "escape": false,
    "hide-empty-text": true,
    "restart-interval": 2,
    "tooltip": true,
    "format": "{}"
  }
}
