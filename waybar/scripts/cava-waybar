#!/usr/bin/env python3
"""Turn cava's raw spectrum into one line of themed Pango markup for Waybar.

Supports:
- Mirror mode: symmetric display with centre=lowest freq, edges=highest.
  Display order: barN…bar1 | bar1…barN
- Color modes: gradient (lerp between two theme colors), theme (3 groups),
  solid (all bars in accent color).
- All settings configurable via /home/dtechit/.config/waybar/cava-state.json.
"""

from __future__ import annotations

import json
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

BASE = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(BASE / "hypr" / "scripts"))
import theme_engine as engine  # noqa: E402

CAVA_CONF = BASE / "waybar" / "cava.conf"
CAVA_STATE = BASE / "waybar" / "cava-state.json"
BLOCKS = "▁▂▃▄▅▆▇█"
PLAYERCTL = shutil.which("playerctl")
_current_proc: subprocess.Popen | None = None
_restart_requested: bool = False

# Original 3-group coloring (theme mode)
THEME_GROUPS = ((0, 4, "accent"), (4, 8, "gold"), (8, 12, "cyan"))

CAVA_DEFAULTS: dict = {
    "freq_low": 20,
    "freq_high": 1000,
    "bars": 6,
    "noise_reduction": 0.77,
    "sensitivity": 100,
    "mirror": True,
    "color_mode": "gradient",
    "gradient_from": "accent",
    "gradient_to": "gold",
    "framerate": 24,
    "silence_timeout": 32,
    "bar_style": "blocks",
}

ALLOWED_COLOR_KEYS = {"accent", "gold", "cyan", "red", "green", "blue", "fg"}
ALLOWED_COLOR_MODES = {"gradient", "theme", "solid"}


def load_cava_state() -> dict:
    """Read cava-state.json; fall back to defaults if missing or malformed."""
    state = dict(CAVA_DEFAULTS)
    if CAVA_STATE.exists():
        try:
            loaded = json.loads(CAVA_STATE.read_text(encoding="utf-8"))
            state.update(loaded)
        except (OSError, json.JSONDecodeError):
            pass
    # Clamp / validate values
    state["bars"] = max(2, min(12, int(state.get("bars", CAVA_DEFAULTS["bars"]))))
    state["freq_low"] = max(1, int(state.get("freq_low", CAVA_DEFAULTS["freq_low"])))
    state["freq_high"] = max(200, int(state.get("freq_high", CAVA_DEFAULTS["freq_high"])))
    state["noise_reduction"] = float(state.get("noise_reduction", CAVA_DEFAULTS["noise_reduction"]))
    state["sensitivity"] = max(50, min(300, int(state.get("sensitivity", CAVA_DEFAULTS["sensitivity"]))))
    state["framerate"] = max(12, min(60, int(state.get("framerate", CAVA_DEFAULTS["framerate"]))))
    state["silence_timeout"] = max(0, min(120, int(state.get("silence_timeout", CAVA_DEFAULTS["silence_timeout"]))))
    state["mirror"] = bool(state.get("mirror", CAVA_DEFAULTS["mirror"]))
    cm = str(state.get("color_mode", CAVA_DEFAULTS["color_mode"]))
    state["color_mode"] = cm if cm in ALLOWED_COLOR_MODES else "gradient"
    gf = str(state.get("gradient_from", CAVA_DEFAULTS["gradient_from"]))
    state["gradient_from"] = gf if gf in ALLOWED_COLOR_KEYS else "accent"
    gt = str(state.get("gradient_to", CAVA_DEFAULTS["gradient_to"]))
    state["gradient_to"] = gt if gt in ALLOWED_COLOR_KEYS else "gold"
    return state


def write_cava_conf(state: dict) -> None:
    """Regenerate cava.conf from the given state dict."""
    text = (
        "# Raw audio data for the Waybar music visualizer.\n"
        "# Generated by cava-waybar on startup — edit cava-state.json instead.\n"
        "\n"
        "[general]\n"
        f"bars = {state['bars']}\n"
        f"framerate = {state['framerate']}\n"
        "autosens = 1\n"
        f"sensitivity = {state['sensitivity']}\n"
        f"lower_cutoff_freq = {state['freq_low']}\n"
        f"higher_cutoff_freq = {state['freq_high']}\n"
        "\n"
        "[input]\n"
        "method = pulse\n"
        "source = @DEFAULT_MONITOR@\n"
        "\n"
        "[output]\n"
        "method = raw\n"
        "raw_target = /dev/stdout\n"
        "data_format = ascii\n"
        "ascii_max_range = 7\n"
        "bar_delimiter = 59\n"
        "frame_delimiter = 10\n"
        "\n"
        "[smoothing]\n"
        f"noise_reduction = {state['noise_reduction']:.2f}\n"
    )
    CAVA_CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CAVA_CONF.with_name(CAVA_CONF.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(CAVA_CONF)


def current_track() -> str:
    if not PLAYERCTL:
        return ""
    try:
        result = subprocess.run(
            [PLAYERCTL, "metadata", "--format", "{{title}} — {{artist}}"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode == 0:
            track = result.stdout.strip().replace(" | YouTube Music", "")
            track = track.removesuffix(" —").removesuffix(" -").strip()
            return track
    except Exception:
        pass
    return ""


def cava_binary() -> str | None:
    local = Path.home() / ".local" / "bin" / "cava"
    if local.exists():
        return str(local)
    return shutil.which("cava")


def stop_child(_signum=None, _frame=None) -> None:
    if _current_proc is not None:
        try:
            _current_proc.terminate()
        except OSError:
            pass
    raise SystemExit(0)


def request_restart(_signum=None, _frame=None) -> None:
    """SIGUSR1 handler: flag main loop to restart cava."""
    global _restart_requested
    _restart_requested = True
    if _current_proc is not None:
        try:
            _current_proc.terminate()
        except OSError:
            pass


def load_colors() -> dict:
    return engine.load_theme()["colors"]


def _hex_to_rgb(hex_color: str) -> tuple[int, int, int]:
    h = hex_color.strip().lstrip("#")
    if len(h) == 3:
        h = h[0] * 2 + h[1] * 2 + h[2] * 2
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _lerp_color(color_a: str, color_b: str, t: float) -> str:
    """Linear interpolate between two hex colors; t=0 → a, t=1 → b."""
    ar, ag, ab = _hex_to_rgb(color_a)
    br, bg, bb = _hex_to_rgb(color_b)
    r = int(ar + (br - ar) * t)
    g = int(ag + (bg - ag) * t)
    b = int(ab + (bb - ab) * t)
    return f"#{r:02x}{g:02x}{b:02x}"


def parse_values(line: str, num_bars: int) -> list[int] | None:
    values: list[int] = []
    for part in line.strip().split(";"):
        part = part.strip()
        if not part:
            continue
        try:
            values.append(max(0, min(7, int(float(part)))))
        except ValueError:
            return None
    if not values:
        return None
    return values[:num_bars]


def render(values: list[int], colors: dict, cava_state: dict) -> str:
    """
    Render bars as Pango markup.

    Mirror mode (mirror=True):
      cava outputs bar1 (lowest freq) first, barN (highest) last.
      Display: barN…bar1 | bar1…barN  (centre=lowest, edges=highest)
      Gradient applied per displayed bar position.

    Normal mode (mirror=False):
      Display: bar1…barN (low to high, left to right)

    Color modes:
      gradient - smooth lerp between colors[gradient_from] and colors[gradient_to]
      theme    - original 3-group coloring (accent/gold/cyan per 4 bars)
      solid    - all bars in accent color
    """
    n = len(values)
    if n == 0:
        return ""

    mirror: bool = cava_state.get("mirror", True)
    color_mode: str = cava_state.get("color_mode", "gradient")
    grad_from: str = cava_state.get("gradient_from", "accent")
    grad_to: str = cava_state.get("gradient_to", "gold")

    sep = "\u2009"  # thin space

    if mirror:
        # Build list of (value, display_index_in_full_array) for 2*n bars
        # Left half: [barN, barN-1, ..., bar1] = values reversed
        # Right half: [bar1, bar2, ..., barN] = values as-is
        display_values = list(reversed(values)) + list(values)
        total = len(display_values)  # 2*n
        centre = n  # index of the boundary (first bar of right half = bar1)

        def _gradient_color(pos: int) -> str:
            # pos: 0..total-1; centre is lowest freq
            # distance from centre: 0 at pos=n-1 or pos=n (innermost), max at edges
            dist_from_centre = abs(pos - (centre - 0.5)) / (centre - 0.5)
            # dist_from_centre: 0 at centre gap, 1 at outermost edges
            # We want: centre = grad_to, edges = grad_from
            t = 1.0 - dist_from_centre  # t=1 at centre, t=0 at edges
            edge_color = colors.get(grad_from, "#ffffff")
            centre_color = colors.get(grad_to, "#ffcc00")
            return _lerp_color(edge_color, centre_color, t)

        chars: list[str] = []
        for pos, val in enumerate(display_values):
            char = BLOCKS[val]
            if color_mode == "gradient":
                color = _gradient_color(pos)
                chars.append(f'<span foreground="{color}">{char}</span>')
            elif color_mode == "solid":
                color = colors.get("accent", "#ffffff")
                chars.append(f'<span foreground="{color}">{char}</span>')
            else:
                # theme mode: group by position within a half
                half_idx = pos if pos < n else total - 1 - pos
                # half_idx: 0 (edge=highest) to n-1 (centre=lowest)
                group_size = max(1, n // 3)
                if half_idx < group_size:
                    color = colors.get("accent", "#ffffff")
                elif half_idx < 2 * group_size:
                    color = colors.get("gold", "#ffcc00")
                else:
                    color = colors.get("cyan", "#00ffff")
                chars.append(f'<span foreground="{color}">{char}</span>')

        # Split into left/right halves with a small space between
        left = sep.join(chars[:n])
        right = sep.join(chars[n:])
        return f"{left} {right}"

    else:
        # Normal left-to-right display (bar1=lowest on left, barN=highest on right)
        chars = []
        for i, val in enumerate(values):
            char = BLOCKS[val]
            if color_mode == "gradient":
                t = i / max(n - 1, 1)
                edge_color = colors.get(grad_from, "#ffffff")
                far_color = colors.get(grad_to, "#ffcc00")
                color = _lerp_color(edge_color, far_color, t)
                chars.append(f'<span foreground="{color}">{char}</span>')
            elif color_mode == "solid":
                color = colors.get("accent", "#ffffff")
                chars.append(f'<span foreground="{color}">{char}</span>')
            else:
                # theme: replicate original 3-group behavior scaled to n bars
                group_size = max(1, n // 3)
                if i < group_size:
                    if val > 0:
                        val = min(7, val + 1)  # low-end punch
                    color = colors.get("accent", "#ffffff")
                elif i < 2 * group_size:
                    color = colors.get("gold", "#ffcc00")
                else:
                    color = colors.get("cyan", "#00ffff")
                chars.append(f'<span foreground="{color}">{char}</span>')
        return sep.join(chars)


def main() -> int:
    global _restart_requested

    signal.signal(signal.SIGTERM, stop_child)
    signal.signal(signal.SIGINT, stop_child)
    signal.signal(signal.SIGUSR1, request_restart)

    binary = cava_binary()
    if not binary:
        print("cava is not installed", file=sys.stderr)
        return 1

    colors = load_colors()
    state_mtime = engine.STATE_PATH.stat().st_mtime if engine.STATE_PATH.exists() else 0.0
    cava_state_mtime = CAVA_STATE.stat().st_mtime if CAVA_STATE.exists() else 0.0
    last_theme_check = 0.0
    last_track_check = 0.0
    track = current_track()
    silence = 0

    while True:
        global _current_proc
        _restart_requested = False

        # Load cava state and regenerate config before each launch
        cava_state = load_cava_state()
        write_cava_conf(cava_state)
        num_bars = cava_state["bars"]
        silence_threshold = cava_state["silence_timeout"]

        _current_proc = subprocess.Popen(
            [binary, "-p", str(CAVA_CONF)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
        try:
            assert _current_proc.stdout is not None
            for line in _current_proc.stdout:
                if _restart_requested:
                    break

                now = time.monotonic()
                if now - last_theme_check > 1.0:
                    last_theme_check = now
                    try:
                        mtime = engine.STATE_PATH.stat().st_mtime
                        if mtime != state_mtime:
                            colors = load_colors()
                            state_mtime = mtime
                    except OSError:
                        pass
                    # Watch cava-state.json for external changes (control center)
                    try:
                        cmtime = CAVA_STATE.stat().st_mtime
                        if cmtime != cava_state_mtime:
                            cava_state_mtime = cmtime
                            _restart_requested = True
                            break
                    except OSError:
                        pass

                if now - last_track_check > 2.0:
                    last_track_check = now
                    track = current_track()
                tooltip = track or "Music visualizer"

                values = parse_values(line, num_bars)
                if values is None:
                    continue
                if max(values) == 0:
                    silence += 1
                else:
                    silence = 0

                # silence_threshold=0 means never hide
                if silence_threshold > 0 and silence > silence_threshold:
                    print(
                        json.dumps({"text": "", "tooltip": tooltip}, ensure_ascii=False),
                        flush=True,
                    )
                else:
                    print(
                        json.dumps(
                            {"text": render(values, colors, cava_state), "tooltip": tooltip},
                            ensure_ascii=False,
                        ),
                        flush=True,
                    )
        except (BrokenPipeError, KeyboardInterrupt):
            break
        finally:
            try:
                _current_proc.terminate()
            except OSError:
                pass

        if not _restart_requested:
            time.sleep(1)
        else:
            # Brief pause to let cava-state.json settle before restarting
            time.sleep(0.3)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
