#!/usr/bin/env python3
"""Turn cava's raw spectrum into one line of themed Pango markup for Waybar.

Supports:
- Mirror mode: symmetric display with centre=lowest freq, edges=highest.
  Display order: barN…bar1 | bar1…barN
- Color modes: gradient (lerp between two theme colors), theme (3 groups),
  solid (all bars in accent color).
- All settings configurable via /home/maul/.config/waybar/cava-state.json.
"""

from __future__ import annotations

import json
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

BASE = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(BASE / "hypr" / "scripts"))
import theme_engine as engine  # noqa: E402

CAVA_CONF = BASE / "waybar" / "cava.conf"
CAVA_STATE = BASE / "waybar" / "cava-state.json"
BLOCKS = "▁▂▃▄▅▆▇█"
PLAYERCTL = shutil.which("playerctl")
_current_proc: subprocess.Popen | None = None
_restart_requested: bool = False

# Original 3-group coloring (theme mode)
THEME_GROUPS = ((0, 4, "accent"), (4, 8, "gold"), (8, 12, "cyan"))

CAVA_DEFAULTS: dict = {
    "enabled": True,
    "freq_low": 20,
    "freq_high": 1000,
    "bars": 6,
    "noise_reduction": 0.77,
    "sensitivity": 100,
    "channels": "mono",
    "direction": "middle-out",
    "mirror": True,
    "group_mode": "gradient",
    "group_gap": True,
    "bass_punch": True,
    "color_1": "accent",
    "color_2": "gold",
    "color_3": "cyan",
    "color_4": "red",
    "color_mode": "gradient",
    "gradient_from": "accent",
    "gradient_to": "gold",
    "framerate": 24,
    "silence_timeout": 32,
    "bar_style": "blocks",
}

ALLOWED_COLOR_KEYS = {"accent", "accent_alt", "gold", "cyan", "green", "red", "blue", "magenta", "orange", "fg"}
ALLOWED_DIRECTIONS = {"middle-out", "edges-in", "left-to-right", "right-to-left"}
ALLOWED_GROUP_MODES = {"1", "2", "3", "4", "gradient"}


def load_cava_state() -> dict:
    """Read cava-state.json; fall back to defaults if missing or malformed."""
    state = dict(CAVA_DEFAULTS)
    loaded: dict = {}
    if CAVA_STATE.exists():
        try:
            loaded = json.loads(CAVA_STATE.read_text(encoding="utf-8"))
            state.update(loaded)
        except (OSError, json.JSONDecodeError):
            pass
    state["enabled"] = bool(state.get("enabled", CAVA_DEFAULTS["enabled"]))
    # Clamp / validate values
    state["bars"] = max(2, min(32, int(state.get("bars", CAVA_DEFAULTS["bars"]))))
    state["freq_low"] = max(1, min(1000, int(state.get("freq_low", CAVA_DEFAULTS["freq_low"]))))
    state["freq_high"] = max(100, min(22000, int(state.get("freq_high", CAVA_DEFAULTS["freq_high"]))))
    state["noise_reduction"] = float(state.get("noise_reduction", CAVA_DEFAULTS["noise_reduction"]))
    state["sensitivity"] = max(50, min(300, int(state.get("sensitivity", CAVA_DEFAULTS["sensitivity"]))))
    channels = str(state.get("channels", CAVA_DEFAULTS["channels"]))
    state["channels"] = channels if channels in {"mono", "stereo"} else "mono"
    state["framerate"] = max(12, min(60, int(state.get("framerate", CAVA_DEFAULTS["framerate"]))))
    state["silence_timeout"] = max(0, min(120, int(state.get("silence_timeout", CAVA_DEFAULTS["silence_timeout"]))))

    direction = str(state.get("direction", ""))
    if "mirror" in loaded:
        if not bool(state["mirror"]) and direction in ("middle-out", "edges-in"):
            direction = "left-to-right"
    if not direction:
        direction = "middle-out" if state.get("mirror", True) else "left-to-right"
    state["direction"] = direction if direction in ALLOWED_DIRECTIONS else "middle-out"
    state["mirror"] = state["direction"] in ("middle-out", "edges-in")

    gm = str(state.get("group_mode", ""))
    if not gm:
        cm = str(state.get("color_mode", "gradient"))
        gm = "gradient" if cm == "gradient" else ("1" if cm == "solid" else "3")
    state["group_mode"] = gm if gm in ALLOWED_GROUP_MODES else "gradient"
    state["group_gap"] = bool(state.get("group_gap", True))
    state["bass_punch"] = bool(state.get("bass_punch", True))

    for c_key in ("color_1", "color_2", "color_3", "color_4", "gradient_from", "gradient_to"):
        c_val = str(state.get(c_key, CAVA_DEFAULTS.get(c_key, "accent")))
        state[c_key] = c_val if c_val in ALLOWED_COLOR_KEYS else "accent"

    return state


def write_cava_conf(state: dict) -> None:
    """Regenerate cava.conf from the given state dict."""
    channel_config = f"channels = {state['channels']}\n"
    if state["channels"] == "mono":
        channel_config += "mono_option = average\n"
    text = (
        "# Raw audio data for the Waybar music visualizer.\n"
        "# Generated by cava-waybar on startup — edit cava-state.json instead.\n"
        "\n"
        "[general]\n"
        f"bars = {state['bars']}\n"
        f"framerate = {state['framerate']}\n"
        "autosens = 1\n"
        f"sensitivity = {state['sensitivity']}\n"
        f"lower_cutoff_freq = {state['freq_low']}\n"
        f"higher_cutoff_freq = {state['freq_high']}\n"
        "\n"
        "[input]\n"
        "method = pulse\n"
        "source = @DEFAULT_MONITOR@\n"
        "\n"
        "[output]\n"
        "method = raw\n"
        f"{channel_config}"
        "raw_target = /dev/stdout\n"
        "data_format = ascii\n"
        "ascii_max_range = 7\n"
        "bar_delimiter = 59\n"
        "frame_delimiter = 10\n"
        "\n"
        "[smoothing]\n"
        f"noise_reduction = {state['noise_reduction']:.2f}\n"
    )
    CAVA_CONF.parent.mkdir(parents=True, exist_ok=True)
    tmp = CAVA_CONF.with_name(CAVA_CONF.name + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(CAVA_CONF)


def current_track() -> str:
    if not PLAYERCTL:
        return ""
    try:
        result = subprocess.run(
            [PLAYERCTL, "metadata", "--format", "{{title}} — {{artist}}"],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if result.returncode == 0:
            track = result.stdout.strip().replace(" | YouTube Music", "")
            track = track.removesuffix(" —").removesuffix(" -").strip()
            return track
    except Exception:
        pass
    return ""


def cava_binary() -> str | None:
    local = Path.home() / ".local" / "bin" / "cava"
    if local.exists():
        return str(local)
    return shutil.which("cava")


def stop_child(_signum=None, _frame=None) -> None:
    if _current_proc is not None:
        try:
            _current_proc.terminate()
        except OSError:
            pass
    raise SystemExit(0)


def request_restart(_signum=None, _frame=None) -> None:
    """SIGUSR1 handler: flag main loop to restart cava."""
    global _restart_requested
    _restart_requested = True
    if _current_proc is not None:
        try:
            _current_proc.terminate()
        except OSError:
            pass


def load_colors() -> dict:
    return engine.load_theme()["colors"]


def _hex_to_rgb(hex_color: str) -> tuple[int, int, int]:
    h = hex_color.strip().lstrip("#")
    if len(h) == 3:
        h = h[0] * 2 + h[1] * 2 + h[2] * 2
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _lerp_color(color_a: str, color_b: str, t: float) -> str:
    """Linear interpolate between two hex colors; t=0 → a, t=1 → b."""
    ar, ag, ab = _hex_to_rgb(color_a)
    br, bg, bb = _hex_to_rgb(color_b)
    r = int(ar + (br - ar) * t)
    g = int(ag + (bg - ag) * t)
    b = int(ab + (bb - ab) * t)
    return f"#{r:02x}{g:02x}{b:02x}"


def parse_values(line: str, num_bars: int) -> list[int] | None:
    values: list[int] = []
    for part in line.strip().split(";"):
        part = part.strip()
        if not part:
            continue
        try:
            values.append(max(0, min(7, int(float(part)))))
        except ValueError:
            return None
    if not values:
        return None
    return values[:num_bars]


def render(values: list[int], colors: dict, cava_state: dict) -> str:
    return engine.render_cava(values, colors, cava_state)


def main() -> int:
    global _restart_requested

    signal.signal(signal.SIGTERM, stop_child)
    signal.signal(signal.SIGINT, stop_child)
    signal.signal(signal.SIGUSR1, request_restart)

    binary = cava_binary()
    if not binary:
        print("cava is not installed", file=sys.stderr)
        return 1

    colors = load_colors()
    state_mtime = engine.STATE_PATH.stat().st_mtime if engine.STATE_PATH.exists() else 0.0
    cava_state_mtime = CAVA_STATE.stat().st_mtime if CAVA_STATE.exists() else 0.0
    last_theme_check = 0.0
    last_track_check = 0.0
    track = current_track()
    silence = 0

    while True:
        global _current_proc
        _restart_requested = False

        # Load cava state and regenerate config before each launch
        cava_state = load_cava_state()
        if not cava_state.get("enabled", True):
            print(json.dumps({"text": "", "tooltip": "Music visualizer disabled"}, ensure_ascii=False), flush=True)
            time.sleep(1)
            continue
        write_cava_conf(cava_state)
        num_bars = cava_state["bars"]
        silence_threshold = cava_state["silence_timeout"]

        _current_proc = subprocess.Popen(
            [binary, "-p", str(CAVA_CONF)],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            bufsize=1,
        )
        try:
            assert _current_proc.stdout is not None
            for line in _current_proc.stdout:
                if _restart_requested:
                    break

                now = time.monotonic()
                if now - last_theme_check > 1.0:
                    last_theme_check = now
                    try:
                        mtime = engine.STATE_PATH.stat().st_mtime
                        if mtime != state_mtime:
                            colors = load_colors()
                            state_mtime = mtime
                    except OSError:
                        pass
                    # Watch cava-state.json for external changes (control center)
                    try:
                        cmtime = CAVA_STATE.stat().st_mtime
                        if cmtime != cava_state_mtime:
                            cava_state_mtime = cmtime
                            _restart_requested = True
                            break
                    except OSError:
                        pass

                if now - last_track_check > 2.0:
                    last_track_check = now
                    track = current_track()
                tooltip = track or "Music visualizer"

                values = parse_values(line, num_bars)
                if values is None:
                    continue
                if max(values) == 0:
                    silence += 1
                else:
                    silence = 0

                # silence_threshold=0 means never hide
                if silence_threshold > 0 and silence > silence_threshold:
                    print(
                        json.dumps({"text": "", "tooltip": tooltip}, ensure_ascii=False),
                        flush=True,
                    )
                else:
                    print(
                        json.dumps(
                            {"text": render(values, colors, cava_state), "tooltip": tooltip},
                            ensure_ascii=False,
                        ),
                        flush=True,
                    )
        except (BrokenPipeError, KeyboardInterrupt):
            break
        finally:
            try:
                _current_proc.terminate()
            except OSError:
                pass

        if not _restart_requested:
            time.sleep(1)
        else:
            # Brief pause to let cava-state.json settle before restarting
            time.sleep(0.3)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
