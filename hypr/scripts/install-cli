#!/usr/bin/env bash
# install-cli — expose the dotfiles helper commands in ~/.local/bin.
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
BIN="$HOME/.local/bin"
mkdir -p "$BIN"

for name in theme-switch wallpaper-set waybar-mode hypr-control-center emoji-picker; do
    target="$CONFIG/hypr/scripts/$name"
    [[ -x "$target" ]] || continue
    printf '#!/usr/bin/env bash\nexec "%s" "$@"\n' "$target" >"$BIN/$name"
    chmod +x "$BIN/$name"
done

echo "Installed command wrappers in $BIN"
