    def on_sddm_switch(self, switch: Gtk.Switch, state: bool, key: str) -> bool:
        if self._sddm_syncing:
            return False
        self.run_sddm_action(f"{key}-{'on' if state else 'off'}")
        return False

    def run_sddm_action(self, *args: str) -> None:
        if not shutil.which("pkexec"):
            self.show_error("pkexec is not installed; run install-sddm from a terminal.")
            return
        try:
            subprocess.Popen(
                ["pkexec", str(SCRIPTS / "sddm-config"), *args],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            self.set_status("Authorise the SDDM change in the polkit prompt", timeout=0)
            GLib.timeout_add(1500, self.refresh_sddm_state)
        except Exception as exc:
            self.show_error(str(exc))

    def apply_sddm(self) -> None:
        try:
            engine.apply_theme()
        except Exception as exc:
            self.show_error(str(exc))
            return
        if not shutil.which("pkexec"):
            self.show_error("pkexec is not installed; run install-sddm from a terminal.")
            return
        try:
            subprocess.Popen(
                ["pkexec", str(SCRIPTS / "install-sddm")],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            self.set_status("Applying the current palette to SDDM…", timeout=0)
            GLib.timeout_add(2000, self.refresh_sddm_state)
        except Exception as exc:
            self.show_error(str(exc))

    def open_sddm_config(self) -> None:
        subprocess.Popen(
            ["xdg-open", "/etc/sddm.conf.d"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    def refresh_sddm_state(self) -> bool:
        if not self.sddm_labels:
            return False
        conf = Path("/etc/sddm.conf.d")

        def read_conf(name: str) -> str:
            try:
                return (conf / name).read_text(encoding="utf-8")
            except OSError:
                return ""

        def value(text: str, key: str) -> str:
            for line in text.splitlines():
                if line.strip().startswith(key + "="):
                    return line.split("=", 1)[1].strip()
            return ""

        auto = read_conf("10-autologin.conf")
        auto_user = value(auto, "User")
        auto_session = value(auto, "Session")
        input_method = value(read_conf("30-input-method.conf"), "InputMethod")
        # Empty means "use SDDM's default", which is qtvirtualkeyboard. Only
        # compose/ibus are explicit physical-keyboard settings.
        keyboard_on = input_method not in ("compose", "ibus")
        theme_conf = read_conf("20-theme.conf")
        theme_name = value(theme_conf, "Current") or "default"
        installed = Path("/usr/share/sddm/themes/ascent/theme.conf").exists()
        try:
            active = subprocess.run(
                ["systemctl", "is-active", "sddm"],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip() or "unknown"
        except Exception:
            active = "unknown"
        try:
            enabled = subprocess.run(
                ["systemctl", "is-enabled", "sddm"],
                capture_output=True, text=True, timeout=2,
            ).stdout.strip() or "unknown"
        except Exception:
            enabled = "unknown"

        self.sddm_labels["service"].set_text(f"SDDM · {active} / {enabled}")
        self.sddm_labels["theme"].set_text(
            f"{theme_name}" + (" · installed" if installed else " · not installed")
        )
        self.sddm_labels["autologin"].set_text(
            f"{auto_user} → {auto_session}" if auto_user else "off"
        )
        if input_method == "":
            self.sddm_labels["keyboard"].set_text("on (SDDM default: Qt Virtual Keyboard)")
        elif keyboard_on:
            self.sddm_labels["keyboard"].set_text("on (Qt Virtual Keyboard)")
        else:
            self.sddm_labels["keyboard"].set_text(f"off ({input_method})")
        self.sddm_labels["config"].set_text(str(conf))

        self._sddm_syncing = True
        if "autologin" in self.sddm_switches:
            self.sddm_switches["autologin"].set_active(bool(auto_user))
        if "keyboard" in self.sddm_switches:
            self.sddm_switches["keyboard"].set_active(keyboard_on)
        self._sddm_syncing = False
        return False

    # ------------------------------------------------------------------ #
    # keybinds page
    # ------------------------------------------------------------------ #
    def make_keys_page(self) -> Gtk.Widget:
        scroll, content = self.page()
