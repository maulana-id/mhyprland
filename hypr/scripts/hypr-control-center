            screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )
        self._css_provider = provider


def main() -> int:
    parser = argparse.ArgumentParser(description="Hypr Control Center")
    parser.add_argument("--tab", choices=[p[0] for p in PAGES], default="theme")
    args, _unknown = parser.parse_known_args()

    GLib.set_prgname(APP_ID)
    GLib.set_application_name("Hypr Control Center")
    try:
        Gdk.set_program_class("hypr-control-center")
    except Exception:
        pass

    app = ControlCenter(args.tab)
    return app.run([sys.argv[0], "--tab", args.tab])


if __name__ == "__main__":
    raise SystemExit(main())
