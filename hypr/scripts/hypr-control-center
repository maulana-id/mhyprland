            btn = button(pos.title(), "ghost", lambda p=pos: self.apply_position(p))
            btn.set_size_request(100, -1)
            pos_row.pack_start(btn, False, False, 0)
            self.position_buttons[pos] = btn
        pos_card.pack_start(pos_row, False, False, 0)
        content.pack_start(pos_card, False, False, 0)

        # ---- Music visualizer card (quick link to Visualizer page) --------
        vis_card = vbox(6)
