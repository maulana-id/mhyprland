    def apply_layout(self, name: str) -> None:
        self.set_status(f"Applying Waybar layout: {name}…", timeout=0)
        self.pump()
        try:
            engine.apply_waybar(name)
            self.refresh_bar_state()
            self.refresh_status()
            self.set_status(f"Waybar layout: {name}")
        except Exception as exc:
            self.show_error(str(exc))

    def apply_position(self, position: str) -> None:
        self.set_status(f"Moving Waybar: {position}…", timeout=0)
        self.pump()
        try:
            engine.apply_waybar(position=position)
            self.refresh_bar_state()
            self.refresh_status()
            self.set_status(f"Waybar position: {position}")
        except Exception as exc:
            self.show_error(str(exc))

    def restart_waybar(self) -> None:
        self.set_status("Restarting Waybar…", timeout=0)
        self.pump()
        if engine.restart_waybar():
            self.refresh_status()
            self.set_status("Waybar restarted")
        else:
            self.set_status("Waybar failed to start", timeout=8)

