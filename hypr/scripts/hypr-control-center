        # -------------------------------------------------------------------

        actions = hbox(8)
        actions.pack_start(button("Restart Waybar", "accent", self.restart_waybar, icon="󰑓"), False, False, 0)
        actions.pack_start(button("Theme page", "ghost", lambda: self.show_page("theme"), icon="󰏘"), False, False, 0)
        content.pack_start(actions, False, False, 0)

        self.bar_current = lbl("", "muted")
        content.pack_start(self.bar_current, False, False, 0)
