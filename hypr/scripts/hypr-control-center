            scale.connect("value-changed", self.on_scale, key)
            row.pack_end(scale, False, False, 0)
            self.scales[key] = scale
            dyn_card.pack_start(row, False, False, 0)

        content.pack_start(dyn_card, False, False, 0)

        # 6. Action buttons
        actions = hbox(8)
        actions.pack_start(button("Restart visualizer", "accent", self.restart_visualizer, icon="󰑓"), False, False, 0)
        actions.pack_start(button("Reset defaults", "ghost", self.reset_cava_defaults, icon="󰑓"), False, False, 0)
        actions.pack_start(button("Waybar layout", "ghost", lambda: self.show_page("bar"), icon="󰕘"), False, False, 0)
        content.pack_start(actions, False, False, 0)

        return scroll

    def set_cava_freq_preset(self, low: int, high: int) -> None:
        try:
            engine.set_option("cava_freq_low", low)
            engine.set_option("cava_freq_high", high)
            if "cava_freq_low" in self.scales:
                self.scales["cava_freq_low"].set_value(low)
            if "cava_freq_high" in self.scales:
                self.scales["cava_freq_high"].set_value(high)
            self.update_cava_preview()
            self.set_status(f"Frequency range: {low} Hz – {high} Hz")
        except Exception as exc:
            self.show_error(str(exc))

    def set_cava_bar_preset(self, count: int) -> None:
        try:
            engine.set_option("cava_bars", count)
            if "cava_bars" in self.scales:
                self.scales["cava_bars"].set_value(count)
            self.update_cava_preview()
            self.set_status(f"Bars: {count}")
        except Exception as exc:
            self.show_error(str(exc))

    def restart_visualizer(self) -> None:
        self.set_status("Restarting visualizer…", timeout=0)
        self.pump()
        engine._signal_cava_waybar()
        self.update_cava_preview()
        self.set_status("Visualizer reloaded")

    def update_cava_preview(self) -> None:
        if self.cava_preview_lbl is None:
            return
        try:
            colors = engine.load_theme()["colors"]
            state = engine.load_state()
            if not bool(state.get("cava_enabled", True)):
                self.cava_preview_lbl.set_markup("<span font_size='15pt'>Off</span>")
                return
            bars_count = int(state.get("cava_bars", 6))
            sample = []
            for i in range(bars_count):
                t = i / max(bars_count - 1, 1)
                val = int(6.5 * (1.0 - 0.7 * t) + 1.2 * (1.0 if i % 2 == 0 else 0.4))
                sample.append(max(1, min(7, val)))

            cava_state = {
                "direction": state.get("cava_direction", "middle-out"),
                "group_mode": state.get("cava_group_mode", "gradient"),
                "group_gap": state.get("cava_group_gap", True),
                "bass_punch": state.get("cava_bass_punch", True),
                "color_1": state.get("cava_color_1", "accent"),
                "color_2": state.get("cava_color_2", "gold"),
                "color_3": state.get("cava_color_3", "cyan"),
                "color_4": state.get("cava_color_4", "red"),
            }
            rendered = engine.render_cava(sample, colors, cava_state)
            self.cava_preview_lbl.set_markup(f"<span font_size='15pt'>{rendered}</span>")
        except Exception:
            pass

    def _update_color_rows_visibility(self, group_mode: str) -> None:
        if "cava_color_2" in self.cava_color_rows:
            self.cava_color_rows["cava_color_2"].set_visible(group_mode in ("2", "3", "4", "gradient"))
        if "cava_color_3" in self.cava_color_rows:
            self.cava_color_rows["cava_color_3"].set_visible(group_mode in ("3", "4"))
        if "cava_color_4" in self.cava_color_rows:
            self.cava_color_rows["cava_color_4"].set_visible(group_mode == "4")

    def on_cava_combo(self, combo: Gtk.ComboBoxText, key: str) -> None:
        if self._syncing:
            return
        value = combo.get_active_id() or combo.get_active_text()
        if value is None:
            return
        try:
            engine.set_option(key, value)
            if key == "cava_direction":
                mirrored = value in ("middle-out", "edges-in")
                engine.set_option("cava_mirror", mirrored)
                if "cava_mirror" in self.switches:
                    self.switches["cava_mirror"].set_active(mirrored)
            self.refresh_status()
            self.set_status(f"{key} → {value}")
            if key == "cava_group_mode":
                self._update_color_rows_visibility(value)
            if key in self.cava_swatches:
                theme_colors = engine.load_theme()["colors"]
                c_val = theme_colors.get(value, "#ffffff")
                rgba = Gdk.RGBA()
                if rgba.parse(c_val):
                    self.cava_swatches[key].override_background_color(Gtk.StateFlags.NORMAL, rgba)
            self.update_cava_preview()
        except Exception as exc:
            self.show_error(str(exc))

    def reset_cava_defaults(self) -> None:
        self.set_status("Resetting visualizer defaults…", timeout=0)
        self.pump()
        defaults = {
            "cava_freq_low": 20,
            "cava_freq_high": 1000,
            "cava_bars": 6,
            "cava_noise": 77,
            "cava_sensitivity": 100,
            "cava_enabled": True,
            "cava_channels": "mono",
            "cava_mirror": True,
            "cava_direction": "middle-out",
            "cava_group_mode": "gradient",
            "cava_group_gap": True,
            "cava_bass_punch": True,
            "cava_color_1": "accent",
            "cava_color_2": "gold",
            "cava_color_3": "cyan",
            "cava_color_4": "red",
            "cava_color_mode": "gradient",
            "cava_grad_from": "accent",
            "cava_grad_to": "gold",
            "cava_framerate": 24,
            "cava_silence": 32,
        }
        try:
            for key, value in defaults.items():
                engine.set_option(key, value)
            self.refresh_options()
            self.refresh_status()
            self.set_status("Visualizer defaults reset")
        except Exception as exc:
            self.show_error(str(exc))

    def refresh_bar_state(self) -> None:
        state = engine.load_state()
        for name, card in self.layout_cards.items():
            ctx = card.get_style_context()
            if name == state.get("waybar_layout"):
                ctx.add_class("current")
            else:
                ctx.remove_class("current")
        for pos, btn in self.position_buttons.items():
            ctx = btn.get_style_context()
            if pos == state.get("bar_position"):
                ctx.add_class("active")
            else:
                ctx.remove_class("active")
        if hasattr(self, "bar_current"):
            self.bar_current.set_text(
                f"Current: {state.get('waybar_layout')} / {state.get('bar_position')}"
                f"  ·  {len(engine.waybar_presets())} presets available"
            )

