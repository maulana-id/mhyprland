            ("SUPER + ALT + B", "Hypr Control Center — Waybar layouts"),
            ("SUPER + SHIFT + E", "Quick emoji picker → clipboard"),
            ("SUPER + SHIFT + P", "Pick a colour with hyprpicker"),
            ("SUPER + SHIFT + S", "Region screenshot → clipboard"),
            ("Print", "Region screenshot → swappy"),
            ("SUPER + Print", "Region screenshot → clipboard"),
            ("SUPER + SHIFT + V", "Clipboard history (cliphist + hyprlauncher)"),
            ("SUPER + SHIFT + N", "Pause / resume notifications"),
            ("SUPER + SHIFT + R", "Reload Hyprland config"),
            ("SUPER + 1…0", "Switch workspace"),
            ("SUPER + SHIFT + 1…0", "Move window to workspace"),
            ("SUPER + S", "Toggle scratchpad workspace"),
            ("SUPER + F", "Toggle fullscreen"),
            ("SUPER + V", "Toggle floating"),
            ("SUPER + drag", "Move window with the mouse"),
            ("SUPER + right-drag", "Resize window with the mouse"),
        ]
        for index, (keys, action) in enumerate(rows):
            key = lbl(keys, "key")
            key.set_halign(Gtk.Align.START)
            grid.attach(key, 0, index, 1, 1)
            grid.attach(lbl(action, "status-value"), 1, index, 1, 1)
        card.pack_start(grid, False, False, 0)
        content.pack_start(card, False, False, 0)

        commands = vbox(7)
        commands.get_style_context().add_class("card")
        commands.pack_start(lbl("Terminal commands", "theme-name"), False, False, 0)
        for command, description in (
            ("theme-switch list", "list every palette"),
            ("theme-switch set nord", "apply a palette by name"),
            ("theme-switch next", "cycle palettes"),
            ("theme-switch option blur on", "persist a look-and-feel toggle"),
            ("wallpaper-set ~/Pictures/Wallpapers/foo.png", "set a wallpaper"),
            ("wallpaper-set --random", "random wallpaper"),
            ("wallpaper-set --directory ~/Pictures/Wallpapers", "random slideshow"),
            ("waybar-mode --layout compact --position top", "switch bar preset / position"),
        ):
            row = hbox(12)
            row.pack_start(lbl(command, "code", selectable=True), False, False, 0)
            row.pack_start(lbl(description, "muted"), False, False, 0)
            commands.pack_start(row, False, False, 0)
        commands.pack_start(lbl(
            "Scripts live in ~/.config/hypr/scripts and ~/.config/waybar/scripts. "
            "The repo is intentionally allow-listed to the Hypr ecosystem.",
            "muted", wrap=True,
        ), False, False, 4)
        content.pack_start(commands, False, False, 0)
        return scroll

    # ------------------------------------------------------------------ #
    # status / css
    # ------------------------------------------------------------------ #
    def refresh_status(self) -> None:
        try:
            status = engine.status()
        except Exception:
            return
        self.info_labels["theme"].set_text(f"{status['theme_name']} ({status['theme']})")
        self.info_labels["wallpaper"].set_text(str(status.get("wallpaper") or "—"))
        self.info_labels["hyprpaper"].set_text(
            "running" if status["hyprpaper_running"] else "not running"
        )
        self.info_labels["waybar"].set_text(
            "running" if status["waybar_running"] else "not running"
        )
        self.info_labels["hyprland"].set_text("running" if status["hyprland_running"] else "not running")
        self.info_labels["monitors"].set_text(", ".join(status["monitors"]) or "—")

    def set_status(self, message: str, timeout: int = 5) -> None:
        if not self.status_label:
            return
        self.status_label.set_text(message)
        if self._status_source:
            GLib.source_remove(self._status_source)
            self._status_source = None
        if timeout:
            self._status_source = GLib.timeout_add_seconds(timeout, self.clear_status)

    def clear_status(self) -> bool:
        self._status_source = None
        if self.status_label:
            self.status_label.set_text("Ready")
        return False

    def pump(self) -> None:
        while Gtk.events_pending():
            Gtk.main_iteration_do(False)

    def show_error(self, message: str) -> None:
        dialog = Gtk.MessageDialog(
            parent=self.window,
            flags=0,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text="Something went wrong",
        )
        dialog.format_secondary_text(str(message))
        dialog.run()
        dialog.destroy()
        self.set_status("Error — see dialog", timeout=8)

    def run_shell(self, command: str) -> None:
        subprocess.Popen(["sh", "-c", command], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.set_status("Launched: " + command.split()[0])

