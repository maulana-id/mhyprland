    def on_switch(self, switch: Gtk.Switch, state: bool, key: str) -> bool:
        if self._syncing:
            return False
        try:
            engine.set_option(key, state)
            if key == "cava_mirror":
                current = str(engine.load_state().get("cava_direction", "middle-out"))
                if state and current not in ("middle-out", "edges-in"):
                    current = "middle-out"
                elif not state and current in ("middle-out", "edges-in"):
                    current = "left-to-right"
                engine.set_option("cava_direction", current)
                if "cava_direction" in self.cava_combos:
                    self.cava_combos["cava_direction"].set_active_id(current)
            self.refresh_status()
            self.set_status(f"{key}: {'on' if state else 'off'}")
            if key.startswith("cava_"):
                self.update_cava_preview()
        except Exception as exc:
            self.show_error(str(exc))
            return True
        return False

    def on_scale(self, scale: Gtk.Scale, key: str) -> None:
        value = int(scale.get_value())
        if key in self.value_labels:
            self.value_labels[key].set_text(str(value))
        if key.startswith("cava_"):
            self.update_cava_preview()
        if self._syncing:
            return
        if key in self._pending_options:
            GLib.source_remove(self._pending_options[key])
        self._pending_options[key] = GLib.timeout_add(450, self.apply_scale, key, value)

    def apply_scale(self, key: str, value: int) -> bool:
        self._pending_options.pop(key, None)
        try:
            engine.set_option(key, value)
            self.refresh_status()
            self.set_status(f"{key} → {value}")
            if key.startswith("cava_"):
                self.update_cava_preview()
        except Exception as exc:
            self.show_error(str(exc))
        return False

    def refresh_options(self) -> None:
        state = engine.load_state()
        self._syncing = True
        for key, switch in self.switches.items():
            switch.set_active(bool(state.get(key)))
        for key, scale in self.scales.items():
            scale.set_value(int(state.get(key, 0)))
            if key in self.value_labels:
                self.value_labels[key].set_text(str(int(state.get(key, 0))))
        for key, combo in self.cava_combos.items():
            val = str(state.get(key, ""))
            if val:
                combo.set_active_id(val)
                if combo.get_active() < 0:
                    model = combo.get_model()
                    if model:
                        for idx, row in enumerate(model):
                            if row[0] == val or row[1] == val:
                                combo.set_active(idx)
                                break
        theme_colors = engine.load_theme()["colors"]
        for key, swatch_box in self.cava_swatches.items():
            color_name = str(state.get(key, "accent"))
            c_val = theme_colors.get(color_name, "#ffffff")
            rgba = Gdk.RGBA()
            if rgba.parse(c_val):
                swatch_box.override_background_color(Gtk.StateFlags.NORMAL, rgba)
        gm = str(state.get("cava_group_mode", "gradient"))
        self._update_color_rows_visibility(gm)
        self.update_cava_preview()
        self._syncing = False

    def reapply_theme(self) -> None:
        self.set_status("Re-rendering theme files…", timeout=0)
        self.pump()
        try:
            engine.apply_theme()
            self.refresh_theme_state()
            self.refresh_status()
            self.set_status("Theme files re-applied")
        except Exception as exc:
            self.show_error(str(exc))

