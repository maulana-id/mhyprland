#!/usr/bin/env python3
"""Hypr Control Center — a small GTK3 cockpit for themes, wallpapers and Waybar."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango  # noqa: E402

SCRIPTS = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPTS))
import theme_engine as engine  # noqa: E402

APP_ID = "land.hypr.ControlCenter"
PAGES = [
    ("theme", "󰏘", "Themes"),
    ("wallpaper", "󰸉", "Wallpaper"),
    ("bar", "󰕘", "Waybar"),
    ("cava", "󰝚", "Visualizer"),
    ("desktop", "󰒓", "Desktop"),
    ("login", "󰍃", "Login"),
    ("keys", "󰌌", "Keybinds"),
]
LAYOUT_INFO = {
    "default": ("Default", "Everything: workspaces, media, tray, system and power."),
    "compact": ("Compact", "Launcher, media, audio/network, clock and battery."),
    "minimal": ("Minimal", "Only workspaces, clock and battery."),
    "focus": ("Focus", "Workspaces, media, CPU/RAM, clock and battery."),
}


# --------------------------------------------------------------------------- #
# small GTK helpers
# --------------------------------------------------------------------------- #
def lbl(text: str = "", css: str | None = None, *, markup: bool = False,
        wrap: bool = False, selectable: bool = False, xalign: float = 0.0) -> Gtk.Label:
    widget = Gtk.Label()
    if markup:
        widget.set_markup(text)
    else:
        widget.set_text(text)
    widget.set_xalign(xalign)
    widget.set_line_wrap(wrap)
    widget.set_selectable(selectable)
    if css:
        for name in css.split():
            widget.get_style_context().add_class(name)
    return widget


def hbox(spacing: int = 8, **kwargs) -> Gtk.Box:
    return Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=spacing, **kwargs)


def vbox(spacing: int = 8, **kwargs) -> Gtk.Box:
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=spacing, **kwargs)


def button(text: str, css: str, callback, *, icon: str | None = None) -> Gtk.Button:
    widget = Gtk.Button()
    widget.set_relief(Gtk.ReliefStyle.NONE)
    widget.get_style_context().add_class("action")
    if css:
        for name in css.split():
            widget.get_style_context().add_class(name)
    box = hbox(6)
    if icon:
        box.pack_start(lbl(icon, "action-icon"), False, False, 0)
    box.pack_start(lbl(text), False, False, 0)
    widget.add(box)
    widget.connect("clicked", lambda *_: callback())
    return widget


def section_title(title: str, subtitle: str = "") -> Gtk.Box:
    box = vbox(2)
    box.pack_start(lbl(title, "page-title"), False, False, 0)
    if subtitle:
        box.pack_start(lbl(subtitle, "page-sub", wrap=True), False, False, 0)
    return box


def swatch(color: str, width: int = 24, height: int = 18) -> Gtk.EventBox:
    box = Gtk.EventBox()
    box.set_size_request(width, height)
    rgba = Gdk.RGBA()
    if rgba.parse(color):
        box.override_background_color(Gtk.StateFlags.NORMAL, rgba)
    box.set_margin_end(4)
    return box


# --------------------------------------------------------------------------- #
# application
# --------------------------------------------------------------------------- #
class ControlCenter(Gtk.Application):
    def __init__(self, tab: str = "theme"):
        super().__init__(
            application_id=APP_ID,
            flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE,
        )
        self.tab = tab if tab in {p[0] for p in PAGES} else "theme"
        self.window: Gtk.ApplicationWindow | None = None
        self.stack: Gtk.Stack | None = None
        self.nav_buttons: dict[str, Gtk.Button] = {}
        self.theme_cards: dict[str, Gtk.Button] = {}
        self.theme_active_labels: dict[str, Gtk.Label] = {}
        self.layout_cards: dict[str, Gtk.Button] = {}
        self.position_buttons: dict[str, Gtk.Button] = {}
        self.wallpaper_cards: dict[str, Gtk.Button] = {}
        self.wallpaper_flow: Gtk.FlowBox | None = None
        self.fit_combo: Gtk.ComboBoxText | None = None
        self.header_theme: Gtk.Label | None = None
        self.footer_theme: Gtk.Label | None = None
        self.status_label: Gtk.Label | None = None
        self.info_labels: dict[str, Gtk.Label] = {}
        self.switches: dict[str, Gtk.Switch] = {}
        self.scales: dict[str, Gtk.Scale] = {}
        self.value_labels: dict[str, Gtk.Label] = {}
        self.cava_combos: dict[str, Gtk.ComboBoxText] = {}
        self.cava_preview_lbl: Gtk.Label | None = None
        self.cava_swatches: dict[str, Gtk.EventBox] = {}
        self.cava_color_rows: dict[str, Gtk.Widget] = {}
        self.sddm_labels: dict[str, Gtk.Label] = {}
        self.sddm_switches: dict[str, Gtk.Switch] = {}
        self._sddm_syncing = False
        self._grad_rows: list[Gtk.Widget] = []
        self._css_provider: Gtk.CssProvider | None = None
        self._status_source: int | None = None
        self._pending_options: dict[str, int] = {}
        self._syncing = False
        self._built = False

    # ------------------------------------------------------------------ #
    # window scaffolding
    # ------------------------------------------------------------------ #
    def do_command_line(self, command_line) -> int:
        args = command_line.get_arguments()
        if "--tab" in args:
            index = args.index("--tab")
            if index + 1 < len(args):
                candidate = args[index + 1]
                if candidate in {page[0] for page in PAGES}:
                    self.tab = candidate
        self.do_activate()
        return 0

    def do_activate(self) -> None:
        if not self._built:
            self.build_window()
            self._built = True
        elif self.stack is not None:
            self.show_page(self.tab)
        self.window.present()

    def build_window(self) -> None:
        self.window = Gtk.ApplicationWindow(application=self, title="Hypr Control Center")
        self.window.set_default_size(1000, 700)
        self.window.set_position(Gtk.WindowPosition.CENTER)
        self.window.set_decorated(False)
        self.window.set_icon_name("preferences-desktop-theme")
        self.window.connect("key-press-event", self.on_key_press)

        root = vbox(0)
        self.window.add(root)

        root.pack_start(self.make_topbar(), False, False, 0)

        body = hbox(0)
        body.set_vexpand(True)
        root.pack_start(body, True, True, 0)

        body.pack_start(self.make_sidebar(), False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(160)
        self.stack.set_hexpand(True)
        self.stack.set_vexpand(True)
        for name, _, _ in PAGES:
            self.stack.add_named(getattr(self, f"make_{name}_page")(), name)
        body.pack_start(self.stack, True, True, 0)

        root.pack_start(self.make_footer(), False, False, 0)

        self.stack.set_visible_child_name(self.tab)
        self.update_nav(self.tab)
        self.refresh_theme_state()
        self.refresh_wallpapers()
        self.refresh_bar_state()
        self.refresh_options()
        self.refresh_status()
        self.refresh_sddm_state()
        self.set_status("Ready")

        self.window.show_all()
        # A Gtk.Stack can ignore visible-child before it is mapped; set it again.
        self.stack.set_visible_child_name(self.tab)
        self.update_nav(self.tab)
        self.refresh_theme_state()
        GLib.timeout_add(180, self.center_self)
        self._last_state = engine.load_state()
        GLib.timeout_add(2500, self.poll_state)

    def poll_state(self) -> bool:
        """Pick up theme / wallpaper changes made from Waybar or the CLI."""
        if not self._built:
            return True
        try:
            state = engine.load_state()
        except Exception:
            return True
        changed_theme = state.get("theme") != self._last_state.get("theme")
        changed_wallpaper = state.get("wallpaper") != self._last_state.get("wallpaper")
        if changed_theme:
            self.refresh_theme_state()
        if changed_theme or changed_wallpaper:
            self.refresh_wallpapers()
            self.refresh_status()
            self.refresh_sddm_state()
        self._last_state = state
        return True

    def center_self(self) -> bool:
        """Wayland ignores Gtk.Window.set_position; ask Hyprland to centre us."""
        try:
            result = subprocess.run(
                ["hyprctl", "clients", "-j"], capture_output=True, text=True, timeout=3
            )
            clients = json.loads(result.stdout) if result.returncode == 0 else []
            address = next((c["address"] for c in clients if c.get("pid") == os.getpid()), None)
            if address:
                subprocess.run(
                    ["hyprctl", "dispatch",
                     f'hl.dsp.focus({{ window = "address:{address}" }})'],
                    capture_output=True, text=True, timeout=3,
                )
                subprocess.run(
                    ["hyprctl", "dispatch", "hl.dsp.window.center()"],
                    capture_output=True, text=True, timeout=3,
                )
        except Exception:
            pass
        return False

    def make_topbar(self) -> Gtk.Widget:
        bar = Gtk.EventBox()
        bar.get_style_context().add_class("topbar")
        bar.connect("button-press-event", self.on_topbar_press)

        row = hbox(10)
        row.set_margin_start(16)
        row.set_margin_end(12)
        row.set_margin_top(10)
        row.set_margin_bottom(10)
        bar.add(row)

        mark = lbl("󰀻", "logo")
        row.pack_start(mark, False, False, 0)

        titles = vbox(0)
        titles.pack_start(lbl("Hypr Control Center", "title"), False, False, 0)
        titles.pack_start(lbl("themed desktop cockpit", "subtitle"), False, False, 0)
        row.pack_start(titles, False, False, 0)

        spacer = Gtk.Box()
        row.pack_start(spacer, True, True, 0)

        self.header_theme = lbl("", "pill accent")
        row.pack_start(self.header_theme, False, False, 0)

        minimize = Gtk.Button(label="–")
        minimize.set_relief(Gtk.ReliefStyle.NONE)
        minimize.get_style_context().add_class("winbtn")
        minimize.connect("clicked", lambda *_: self.window.iconify())
        row.pack_start(minimize, False, False, 0)

        close = Gtk.Button(label="✕")
        close.set_relief(Gtk.ReliefStyle.NONE)
        close.get_style_context().add_class("winbtn")
        close.get_style_context().add_class("close")
        close.connect("clicked", lambda *_: self.window.close())
        row.pack_start(close, False, False, 0)
        return bar

    def make_sidebar(self) -> Gtk.Widget:
        sidebar = vbox(4)
        sidebar.get_style_context().add_class("sidebar")
        sidebar.set_size_request(190, -1)
        sidebar.set_margin_start(8)
        sidebar.set_margin_end(8)
        sidebar.set_margin_top(12)
        sidebar.set_margin_bottom(12)

        for name, icon, title in PAGES:
            btn = Gtk.Button()
            btn.set_relief(Gtk.ReliefStyle.NONE)
            btn.get_style_context().add_class("nav")
            row = hbox(10)
            row.pack_start(lbl(icon, "nav-icon"), False, False, 0)
            row.pack_start(lbl(title, "nav-label"), False, False, 0)
            btn.add(row)
            btn.connect("clicked", lambda _b, n=name: self.show_page(n))
            sidebar.pack_start(btn, False, False, 0)
            self.nav_buttons[name] = btn

        sidebar.pack_start(Gtk.Separator(), False, False, 8)

        hint = lbl("SUPER + SHIFT + T", "key")
        hint.set_halign(Gtk.Align.CENTER)
        sidebar.pack_end(hint, False, False, 4)
        tagline = lbl("opens this window", "muted")
        tagline.set_halign(Gtk.Align.CENTER)
        sidebar.pack_end(tagline, False, False, 4)
        return sidebar

    def make_footer(self) -> Gtk.Widget:
        footer = Gtk.EventBox()
        footer.get_style_context().add_class("footer")
        row = hbox(8)
        row.set_margin_start(16)
        row.set_margin_end(16)
        row.set_margin_top(7)
        row.set_margin_bottom(7)
        footer.add(row)

        self.status_label = lbl("Ready", "status")
        row.pack_start(self.status_label, False, False, 0)
        spacer = Gtk.Box()
        row.pack_start(spacer, True, True, 0)
        self.footer_theme = lbl("", "muted")
        row.pack_start(self.footer_theme, False, False, 0)
        return footer

    def page(self) -> tuple[Gtk.ScrolledWindow, Gtk.Box]:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_hexpand(True)
        scroll.set_vexpand(True)
        content = vbox(16)
        content.set_margin_start(22)
        content.set_margin_end(22)
        content.set_margin_top(20)
        content.set_margin_bottom(24)
        scroll.add(content)
        return scroll, content

    def on_key_press(self, _widget, event) -> bool:
        if event.keyval == Gdk.KEY_Escape:
            self.window.close()
            return True
        return False

    def on_topbar_press(self, _widget, event) -> bool:
        if event.button == 1 and self.window is not None:
            self.window.begin_move_drag(event.button, int(event.x_root), int(event.y_root), event.time)
            return True
        return False

    def show_page(self, name: str) -> None:
        self.stack.set_visible_child_name(name)
        self.update_nav(name)

    def update_nav(self, active: str) -> None:
        for name, btn in self.nav_buttons.items():
            ctx = btn.get_style_context()
            if name == active:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")

    # ------------------------------------------------------------------ #
    # theme page
    # ------------------------------------------------------------------ #
    def make_theme_page(self) -> Gtk.Widget:
        scroll, content = self.page()
        header = hbox(12)
        header.pack_start(section_title(
            "Colour themes",
            "One palette drives Hyprland borders, Waybar, kitty, hyprlock and dunst.",
        ), True, True, 0)
        header.pack_start(button("Next theme", "ghost", self.cycle_theme, icon="󰁔"), False, False, 0)
        content.pack_start(header, False, False, 0)

        flow = Gtk.FlowBox()
        flow.set_selection_mode(Gtk.SelectionMode.NONE)
        flow.set_homogeneous(True)
        flow.set_max_children_per_line(3)
        flow.set_min_children_per_line(2)
        flow.set_row_spacing(12)
        flow.set_column_spacing(12)
        flow.set_valign(Gtk.Align.START)
        content.pack_start(flow, False, False, 0)

        for theme in engine.all_themes():
            card = self.theme_card(theme)
            self.theme_cards[theme["slug"]] = card
            flow.add(card)

        content.pack_start(lbl(
            "Theme files are rendered into hypr/theme.lua, waybar/colors.css, "
            "kitty/theme.conf, hyprlock.conf, hyprpaper.conf and dunst/dunstrc.",
            "muted", wrap=True,
        ), False, False, 5)
        return scroll

    def theme_card(self, theme: dict) -> Gtk.Button:
        colors = theme["colors"]
        btn = Gtk.Button()
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.get_style_context().add_class("card")
        btn.set_size_request(270, 150)

        box = vbox(8)
        box.set_margin_start(14)
        box.set_margin_end(14)
        box.set_margin_top(12)
        box.set_margin_bottom(12)
        btn.add(box)

        top = hbox(6)
        top.pack_start(lbl(theme["name"], "theme-name"), True, True, 0)
        active = lbl("", "pill accent")
        self.theme_active_labels[theme["slug"]] = active
        top.pack_end(active, False, False, 0)
        box.pack_start(top, False, False, 0)

        meta = hbox(6)
        meta.pack_start(lbl(theme["variant"], "pill"), False, False, 0)
        if theme["accent_name"]:
            meta.pack_start(lbl(theme["accent_name"], "pill"), False, False, 0)
        box.pack_start(meta, False, False, 0)

        description = lbl(theme["description"], "muted", wrap=True)
        description.set_max_width_chars(34)
        description.set_lines(2)
        description.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(description, True, True, 0)

        strip = hbox(0)
        for key in ("bg", "surface", "accent", "accent_alt", "gold", "fg"):
            strip.pack_start(swatch(colors[key]), False, False, 0)
        box.pack_end(strip, False, False, 0)

        btn.connect("clicked", lambda *_: self.apply_theme(theme["slug"]))
        btn.set_tooltip_text(f"Apply {theme['name']}")
        return btn

    def cycle_theme(self) -> None:
        self.set_status("Applying next theme…", timeout=0)
        self.pump()
        try:
            engine.next_theme(1)
            self.refresh_theme_state()
            self.refresh_status()
            self.set_status(f"Theme: {engine.load_theme()['name']}")
        except Exception as exc:  # pragma: no cover - GUI safety net
            self.show_error(str(exc))

    def apply_theme(self, slug: str) -> None:
        self.set_status(f"Applying {slug}…", timeout=0)
        self.pump()
        try:
            engine.apply_theme(slug)
            self.refresh_theme_state()
            self.refresh_status()
            self.set_status(f"Theme: {engine.load_theme()['name']}")
        except Exception as exc:  # pragma: no cover
            self.show_error(str(exc))

    def refresh_theme_state(self) -> None:
        state = engine.load_state()
        theme = engine.load_theme(state["theme"])
        self.apply_app_css(theme)
        if self.header_theme:
            self.header_theme.set_markup(
                f"<b>{GLib.markup_escape_text(theme['name'])}</b>"
                f"  ·  {GLib.markup_escape_text(theme['accent_name'])}"
            )
        if self.footer_theme:
            self.footer_theme.set_text(
                f"{theme['name']}  ·  {theme['variant']}  ·  {state['theme']}"
            )
        for slug, card in self.theme_cards.items():
            ctx = card.get_style_context()
            if slug == state["theme"]:
                ctx.add_class("current")
                self.theme_active_labels[slug].set_text("ACTIVE")
                self.theme_active_labels[slug].set_visible(True)
            else:
                ctx.remove_class("current")
                self.theme_active_labels[slug].set_text("")
                self.theme_active_labels[slug].set_visible(False)

    # ------------------------------------------------------------------ #
    # wallpaper page
    # ------------------------------------------------------------------ #
    def make_wallpaper_page(self) -> Gtk.Widget:
        scroll, content = self.page()
        header = hbox(12)
        header.pack_start(section_title(
            "Wallpaper",
            f"Images from {engine.WALLPAPER_DIR} — click a thumbnail to apply it everywhere.",
        ), True, True, 0)
        content.pack_start(header, False, False, 0)

        actions = hbox(8)
        actions.pack_start(button("Add images…", "accent", self.add_wallpapers, icon="󰐕"), False, False, 0)
        actions.pack_start(button("Open folder", "ghost", self.open_wallpaper_folder, icon="󰉋"), False, False, 0)
        actions.pack_start(button("Random", "ghost", self.random_wallpaper, icon="󰒲"), False, False, 0)
        actions.pack_start(button("Slideshow folder", "ghost", self.slideshow_folder, icon="󰎁"), False, False, 0)
        actions.pack_start(Gtk.Box(), True, True, 0)

        actions.pack_start(lbl("Fit", "muted"), False, False, 0)
        self.fit_combo = Gtk.ComboBoxText()
        for fit in ("cover", "contain", "fill", "tile"):
            self.fit_combo.append_text(fit)
        self.fit_combo.connect("changed", self.on_fit_changed)
        actions.pack_start(self.fit_combo, False, False, 0)
        content.pack_start(actions, False, False, 0)

        self.wallpaper_flow = Gtk.FlowBox()
        self.wallpaper_flow.set_selection_mode(Gtk.SelectionMode.NONE)
        self.wallpaper_flow.set_homogeneous(True)
        self.wallpaper_flow.set_max_children_per_line(3)
        self.wallpaper_flow.set_min_children_per_line(2)
        self.wallpaper_flow.set_row_spacing(12)
        self.wallpaper_flow.set_column_spacing(12)
        self.wallpaper_flow.set_valign(Gtk.Align.START)
        content.pack_start(self.wallpaper_flow, False, False, 0)

        self.wallpaper_hint = lbl("", "muted", wrap=True)
        content.pack_start(self.wallpaper_hint, False, False, 0)
        return scroll

    def thumb(self, path: Path) -> GdkPixbuf.Pixbuf | None:
        try:
            cache_dir = engine.CACHE_DIR / "thumbs"
            cache_dir.mkdir(parents=True, exist_ok=True)
            key = hashlib.sha1(str(path).encode()).hexdigest()[:16]
            stamp = int(path.stat().st_mtime)
            target = cache_dir / f"{key}-{stamp}.png"
            if target.exists():
                return GdkPixbuf.Pixbuf.new_from_file(str(target))
            pix = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 260, 146, True)
            oriented = pix.apply_embedded_orientation()
            if oriented is not None:
                pix = oriented
            pix.savev(str(target), "png", [], [])
            return pix
        except Exception:
            return None

    def refresh_wallpapers(self) -> None:
        if not self.wallpaper_flow:
            return
        state = engine.load_state()
        raw_current = state.get("wallpaper", "")
        current = engine.expand_path(raw_current) if raw_current else Path("/nonexistent")
        for child in list(self.wallpaper_flow.get_children()):
            self.wallpaper_flow.remove(child)
        self.wallpaper_cards.clear()
        files = engine.list_wallpapers()
        if not files:
            self.wallpaper_flow.add(lbl("No wallpapers yet — add a few images.", "muted"))
        for path in files:
            card = self.wallpaper_card(path)
            key = str(path.resolve())
            if path.resolve() == current:
                card.get_style_context().add_class("current")
            self.wallpaper_cards[key] = card
            self.wallpaper_flow.add(card)
        if self.fit_combo:
            self._syncing = True
            idx = {"cover": 0, "contain": 1, "fill": 2, "tile": 3}.get(state.get("fit_mode", "cover"), 0)
            self.fit_combo.set_active(idx)
            self._syncing = False
        self.wallpaper_hint.set_text(
            f"Current: {state.get('wallpaper')}  ·  fit: {state.get('fit_mode')}  ·  "
            f"{len(files)} image(s)"
        )
        self.wallpaper_flow.show_all()

    def wallpaper_card(self, path: Path) -> Gtk.Button:
        btn = Gtk.Button()
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.get_style_context().add_class("card")
        btn.set_size_request(270, 200)
        btn.set_tooltip_text(str(path))

        box = vbox(7)
        box.set_margin_start(9)
        box.set_margin_end(9)
        box.set_margin_top(9)
        box.set_margin_bottom(9)
        btn.add(box)

        pix = self.thumb(path)
        if pix is not None:
            image = Gtk.Image.new_from_pixbuf(pix)
        else:
            image = Gtk.Image.new_from_icon_name("image-missing", Gtk.IconSize.DIALOG)
        image.set_halign(Gtk.Align.CENTER)
        box.pack_start(image, True, True, 0)

        name = lbl(path.stem, "wallpaper-name")
        name.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
        name.set_max_width_chars(28)
        box.pack_start(name, False, False, 0)

        info = lbl(path.suffix.upper().lstrip("."), "muted")
        box.pack_start(info, False, False, 0)

        btn.connect("clicked", lambda *_: self.apply_wallpaper(path))
        return btn

    def apply_wallpaper(self, path: Path) -> None:
        self.set_status(f"Setting wallpaper: {path.name}…", timeout=0)
        self.pump()
        try:
            state = engine.set_wallpaper(path, self.current_fit())
            self.refresh_wallpapers()
            self.refresh_status()
            if state.get("wallpaper_applied", True):
                self.set_status(f"Wallpaper: {path.name}")
            else:
                self.set_status("Wallpaper saved, but hyprpaper did not confirm it", timeout=8)
        except Exception as exc:
            self.show_error(str(exc))

    def current_fit(self) -> str:
        if not self.fit_combo:
            return "cover"
        return self.fit_combo.get_active_text() or "cover"

    def on_fit_changed(self, _combo) -> None:
        if self._syncing:
            return
        state = engine.load_state()
        wallpaper = state.get("wallpaper")
        if not wallpaper:
            return
        try:
            engine.set_wallpaper(wallpaper, self.current_fit())
            self.refresh_status()
            self.set_status(f"Fit: {self.current_fit()}")
        except Exception as exc:
            self.show_error(str(exc))

    def add_wallpapers(self) -> None:
        dialog = Gtk.FileChooserDialog(
            title="Add wallpapers",
            parent=self.window,
            action=Gtk.FileChooserAction.OPEN,
        )
        dialog.add_buttons(Gtk.STOCK_CANCEL, Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)
        dialog.set_select_multiple(True)
        image_filter = Gtk.FileFilter()
        image_filter.set_name("Images")
        for mime in ("image/png", "image/jpeg", "image/webp"):
            image_filter.add_mime_type(mime)
        dialog.add_filter(image_filter)
        response = dialog.run()
        names = dialog.get_filenames()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        engine.WALLPAPER_DIR.mkdir(parents=True, exist_ok=True)
        last = None
        for name in names:
            src = Path(name)
            dst = engine.WALLPAPER_DIR / src.name
            if dst.exists() and dst.resolve() != src.resolve():
                dst = engine.WALLPAPER_DIR / f"{src.stem}-{int(src.stat().st_mtime)}{src.suffix}"
            if dst.resolve() != src.resolve():
                shutil.copy2(src, dst)
            last = dst
        self.refresh_wallpapers()
        if last:
            self.apply_wallpaper(last)
        else:
            self.set_status("No images added")

    def open_wallpaper_folder(self) -> None:
        engine.WALLPAPER_DIR.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(["xdg-open", str(engine.WALLPAPER_DIR)],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def random_wallpaper(self) -> None:
        try:
            path = engine.random_wallpaper()
            self.apply_wallpaper(path)
        except Exception as exc:
            self.show_error(str(exc))

    def slideshow_folder(self) -> None:
        self.set_status("Starting wallpaper slideshow…", timeout=0)
        self.pump()
        try:
            engine.set_wallpaper(engine.WALLPAPER_DIR, self.current_fit())
            self.refresh_wallpapers()
            self.refresh_status()
            self.set_status("Slideshow: every 5 minutes from Pictures/Wallpapers", timeout=8)
        except Exception as exc:
            self.show_error(str(exc))

