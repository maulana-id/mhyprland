# Generated from ~/.config/hypr/themes/${theme_slug}.toml
# Edit hypr/templates/dunstrc.in, then run `theme-switch apply`.

[global]
    follow = mouse
    width = (340, 460)
    height = (0, 140)
    origin = top-right
    offset = (12, 42)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 5
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 320
    progress_bar_corner_radius = 3
    progress_bar_horizontal_alignment = center

    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    gap_size = 8
    separator_height = 2
    separator_color = frame
    corner_radius = 10

    font = ${font} 10
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false

    enable_recursive_icon_lookup = true
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    mouse_middle_click = close_current
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "${bg}"
    foreground = "${fg_dim}"
    frame_color = "${border}"
    timeout = 4

[urgency_normal]
    background = "${bg}"
    foreground = "${fg}"
    frame_color = "${accent_alt}"
    timeout = 6

[urgency_critical]
    background = "${surface}"
    foreground = "${fg}"
    frame_color = "${accent}"
    timeout = 0
